# Public base URL where uploaded share images are served.
# The official Cloudflare R2 Public Development URL for the somna-share bucket:
PUBLIC_SHARE_BASE_URL=https://pub-d4e88771abf4204879658307182abe9.r2.dev

# When the production custom domain is launched, switch to:
# PUBLIC_SHARE_BASE_URL=https://share.somna.help

# =============================================================================
# Google Analytics 4 (GA4)
# =============================================================================
#
# Set your GA4 Measurement ID to enable client-side page-view analytics.
# Format: G-XXXXXXXXXX
#
# When unset or invalid, analytics is completely disabled (no script is
# injected, no network requests are made).
#
# Analytics only loads in production builds by default. To enable in local
# development (e.g. for testing with GA DebugView), also set VITE_GA_ENABLE_IN_DEV=true.
#
# NEVER commit a real production Measurement ID to source control.
# Set this in .env.local (which is gitignored) or in your deployment platform.
VITE_GA_MEASUREMENT_ID=

# Optional: set to "true" to enable GA4 in development mode.
# Default: disabled in development, enabled in production (when ID is set).
VITE_GA_ENABLE_IN_DEV=false
